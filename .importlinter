# FILE SINH TỰ ĐỘNG bởi scripts/gen_import_contracts.py. Không sửa tay.

[importlinter]
root_package = drugtime
include_external_packages = True

[importlinter:contract:hexagon-layers]
name = Each module: api > adapters > application > domain
type = layers
layers =
    api
    adapters
    application
    domain
containers =
    drugtime.modules.identity
    drugtime.modules.consent
    drugtime.modules.family
    drugtime.modules.access
    drugtime.modules.catalog
    drugtime.modules.interaction
    drugtime.modules.medication
    drugtime.modules.adherence
    drugtime.modules.ai_meal
    drugtime.modules.health

[importlinter:contract:pure-core]
name = domain/application do not import frameworks or I/O libraries
type = forbidden
source_modules =
    drugtime.modules.identity.domain
    drugtime.modules.identity.application
    drugtime.modules.consent.domain
    drugtime.modules.consent.application
    drugtime.modules.family.domain
    drugtime.modules.family.application
    drugtime.modules.access.domain
    drugtime.modules.access.application
    drugtime.modules.catalog.domain
    drugtime.modules.catalog.application
    drugtime.modules.interaction.domain
    drugtime.modules.interaction.application
    drugtime.modules.medication.domain
    drugtime.modules.medication.application
    drugtime.modules.adherence.domain
    drugtime.modules.adherence.application
    drugtime.modules.ai_meal.domain
    drugtime.modules.ai_meal.application
    drugtime.modules.health.domain
    drugtime.modules.health.application
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    psycopg
    redis
    rq
    rq_scheduler
    httpx
    jwt
    pydantic_settings

[importlinter:contract:shared-kernel]
name = shared does not depend on modules or entrypoints
type = forbidden
source_modules =
    drugtime.shared
forbidden_modules =
    drugtime.modules
    drugtime.runtime
    drugtime.notification_gateway
    drugtime.main
    drugtime.worker

[importlinter:contract:modules-no-entrypoints]
name = modules do not import runtime, notification_gateway or entrypoints
type = forbidden
source_modules =
    drugtime.modules
forbidden_modules =
    drugtime.runtime
    drugtime.notification_gateway
    drugtime.main
    drugtime.worker

[importlinter:contract:boundary-identity]
name = Others use identity only through identity.api
type = forbidden
source_modules =
    drugtime.modules.consent
    drugtime.modules.family
    drugtime.modules.access
    drugtime.modules.catalog
    drugtime.modules.interaction
    drugtime.modules.medication
    drugtime.modules.adherence
    drugtime.modules.ai_meal
    drugtime.modules.health
    drugtime.runtime
    drugtime.notification_gateway
forbidden_modules =
    drugtime.modules.identity.adapters
    drugtime.modules.identity.application
    drugtime.modules.identity.domain
allow_indirect_imports = True

[importlinter:contract:core-isolation-identity]
name = identity application/domain do not import other modules
type = forbidden
source_modules =
    drugtime.modules.identity.application
    drugtime.modules.identity.domain
forbidden_modules =
    drugtime.modules.consent
    drugtime.modules.family
    drugtime.modules.access
    drugtime.modules.catalog
    drugtime.modules.interaction
    drugtime.modules.medication
    drugtime.modules.adherence
    drugtime.modules.ai_meal
    drugtime.modules.health

