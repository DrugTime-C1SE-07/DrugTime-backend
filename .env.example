# Backend API và Worker dùng cùng codebase nhưng KHÁC role DB (CD1).
# Backend API:  DATABASE_URL=postgresql+psycopg://api_role:<password>@<host>:5432/postgres
# Worker:       DATABASE_URL=postgresql+psycopg://worker_role:<password>@<host>:5432/postgres
DATABASE_URL=postgresql+psycopg://api_role:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://127.0.0.1:6379/0

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Chỉ Worker cần (xóa tài khoản Auth khi xóa dữ liệu, CD9). Không đặt cho Backend API.
SUPABASE_SERVICE_KEY=
# Xác thực JWT: dùng JWKS (khóa bất đối xứng) nếu có, nếu không dùng secret HS256.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=

NOTIFICATION_CHANNEL=mock   # fcm | mock
FCM_PROJECT_ID=

LLM_API_URL=
LLM_API_KEY=

TICK_INTERVAL_SECONDS=300
MISSED_DOSE_GRACE_MINUTES=60
MISSED_DOSE_OVERLAP_MINUTES=30
HEARTBEAT_MAX_AGE_SECONDS=180
